# Copy to .env — only VITE_-prefixed vars are exposed to the browser bundle.

# Production API root (e.g. https://nordcart-api.onrender.com/api/v1).
# Leave unset in dev — the Vite proxy handles /api/v1 locally.
# VITE_API_URL=

# Stripe publishable (public) test key — Phase 5
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

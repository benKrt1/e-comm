# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=development
# 5001 because macOS AirPlay Receiver squats on port 5000
PORT=5001

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nordcart?retryWrites=true&w=majority

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
# The Vite dev server origin (production: your Vercel URL)
CLIENT_URL=http://localhost:5173

# --- Cloudinary (admin product-image uploads, Phase 7) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe test mode (Phase 5) ---
STRIPE_SECRET_KEY=sk_test_...
